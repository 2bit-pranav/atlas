# ======================================================================
# Atlas Agent Unified Configuration
# Toggle MODE to switch between local and cloud: MODE=local OR MODE=cloud
# ======================================================================

# Operation Mode: "local" or "cloud" (Default: local)
MODE=local

# Unified LLM Configuration parameters (used by both local and cloud modes)
# When MODE=local:
#   MODEL_NAME defaults to gemma-4-E2B_q4_0-it
#   BASE_URL defaults to http://127.0.0.1:8000/v1
#   API_KEY defaults to bypass
# When MODE=cloud:
#   MODEL_NAME defaults to gemini-3.5-flash-lite
#   BASE_URL defaults to https://generativelanguage.googleapis.com/v1beta/openai/
#   API_KEY set your Google Gemini API key

MODEL_NAME=gemma-4-E2B_q4_0-it
BASE_URL=http://127.0.0.1:8000/v1
API_KEY=bypass

# Local model files and endpoints
LOCAL_MODEL_NAME=gemma-4-E2B_q4_0-it.gguf
LOCAL_BASE_URL=http://127.0.0.1:8000/v1/

# Cloud model files and endpoints
CLOUD_MODEL_NAME=gemini-3.5-flash-lite
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CLOUD_API_KEY=your-cloud-api-key
EXA_API_KEY=your-exa-api-key

# Browser Automation Headless Mode (true / false)
HEADLESS=true
