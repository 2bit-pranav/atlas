# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode-test/

# Logs and crash dumps
*.log
*.pid
*.seed
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
*.local
*.pem

# Node / Next.js / frontend dependencies and build output
node_modules/
**/node_modules/
.pnpm-store/
.npm/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
*.tsbuildinfo

# Python / FastAPI / agent artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.venv/
venv/
ENV/
env/
pip-wheel-metadata/
*.egg-info/

# Staged chat attachments
server/staging/*
!server/staging/.gitkeep

# Local tooling and app-specific outputs
.vercel/
*.sqlite3
*.sqlite
*.db
reports/
test-output/

# Model and binary assets that should stay local
llm/*.gguf
llm/*.bin
llm/*.safetensors
llm/*.pt
llm/*.onnx
llm/*.ckpt

# Generated TypeScript declaration from Next.js
next-env.d.ts
/agent/old_config.py
/test/*.txt
/llm/*.jinja
/llm/*
/agent/f1_champions.txt
/agent/*.txt

.vscode/
/server/uploads
/server/data_dir/
